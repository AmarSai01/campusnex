# Supabase project settings (Project Settings → API). Copy to .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Demo only: shared password of the seeded demo accounts. Enables the one-click
# demo logins. Leave unset in production.
VITE_DEMO_PASSWORD=
